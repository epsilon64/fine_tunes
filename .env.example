# LLM Fine-Tuning Project - Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env file to version control!

# =============================================================================
# API Keys
# =============================================================================

# Alpha Vantage API Key (for intraday data)
# Get free key at: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=your_alphavantage_key_here

# Twelve Data API Key (optional)
# Get free key at: https://twelvedata.com/pricing
TWELVEDATA_API_KEY=your_twelvedata_key_here

# Polygon.io API Key (optional)
# Get free key at: https://polygon.io/pricing
POLYGON_API_KEY=your_polygon_key_here

# IEX Cloud API Key (optional)
# Get free key at: https://iexcloud.io/pricing
IEX_API_KEY=your_iex_key_here

# =============================================================================
# Model Configuration
# =============================================================================

# HuggingFace API Token (optional, for downloading gated models)
# Get token at: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your_huggingface_token_here

# =============================================================================
# Training Configuration
# =============================================================================

# Default model name
MODEL_NAME=gpt2

# Device (cpu or cuda)
DEVICE=cpu

# Output directory for results
OUTPUT_DIR=./outputs

# Cache directory for downloaded data
CACHE_DIR=./data_cache

# =============================================================================
# Data Configuration
# =============================================================================

# Default tickers for multi-ticker training (comma-separated)
DEFAULT_TICKERS=AAPL,GOOGL,MSFT,NVDA,TSLA,META,AMZN

# Start date for historical data (YYYY-MM-DD)
DATA_START_DATE=2010-01-01

# Sequence length for time series
SEQUENCE_LENGTH=30

# Prediction horizon
PREDICTION_HORIZON=5

# =============================================================================
# Logging
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# =============================================================================
# Notes
# =============================================================================
#
# After setting up this file:
# 1. Copy to .env: cp .env.example .env
# 2. Fill in your API keys
# 3. The .env file will be automatically loaded by examples
# 4. Never commit .env to git (it's in .gitignore)
